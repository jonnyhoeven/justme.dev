{
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vueuse/core": "^15.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "scripts": {
    "docs:generate": "python3 scripts/process_requests.py",
    "docs:generate-splats": "python3 scripts/generate_splats.py",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:py": "python3 -m pytest",
    "test:all": "vitest run --coverage && python3 -m pytest"
  }
}
